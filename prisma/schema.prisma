generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  meals        Meal[]
  goals        Goal[]
}

model Meal {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime
  dateLocal  String?
  category   String
  name       String
  imageUrl   String?
  weightG    Float
  calories   Float
  protein    Float
  carbs      Float
  fat        Float
  confidence Float
  items      String?
  createdAt  DateTime @default(now())

  @@index([userId, dateLocal])
}

model Goal {
  id       Int   @id @default(autoincrement())
  userId   Int
  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  calories Float
  protein  Float
  carbs    Float
  fat      Float
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Food {
  id           Int     @id @default(autoincrement())
  nombre       String
  categoria    String
  cal          Float
  p            Float
  c            Float
  f            Float
  gramsPerUnit Float?
  unitLabel    String?
  source       String  @default("usda")
  userId       Int?

  @@index([nombre])
  @@index([userId])
}
