generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  passwordHash  String
  createdAt     DateTime @default(now())

  // Perfil
  name          String?
  avatarEmoji   String?
  age           Int?
  sex           String?  // "male" | "female"
  weightKg      Float?
  heightCm      Float?
  activityLevel String?  // "sedentary" | "light" | "moderate" | "active" | "very_active"
  fitnessGoal   String?  // "lose" | "maintain" | "gain"

  // Soporte regional (HU-12): ISO 3166-1 alpha-2 ("CO", "MX", "AR", etc.)
  countryCode   String?

  meals             Meal[]
  goals             Goal[]
  foodVotes         FoodVote[]
  weights           WeightEntry[]
  goalLogs          GoalAdjustmentLog[]
  insights          Insight[]
  pushSubscriptions PushSubscription[]
}

model Meal {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime
  dateLocal  String?
  category   String
  name       String
  imageUrl   String?
  weightG    Float
  calories   Float
  protein    Float
  carbs      Float
  fat        Float
  confidence Float
  items      String?
  createdAt  DateTime @default(now())

  @@index([userId, dateLocal])
}

model Goal {
  id       Int   @id @default(autoincrement())
  userId   Int
  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  calories Float
  protein  Float
  carbs    Float
  fat      Float

  // Targets adaptativos (HU-05): "manual" | "suggested" | "auto"
  adjustmentMode String @default("manual")

  adjustments GoalAdjustmentLog[]
}

model WeightEntry {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // YYYY-MM-DD
  weightKg  Float
  source    String   @default("manual") // "manual" | "wearable"
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

model GoalAdjustmentLog {
  id          Int      @id @default(autoincrement())
  userId      Int
  goalId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal        Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  // Snapshot del goal anterior y nuevo
  oldCalories Float
  oldProtein  Float
  oldCarbs    Float
  oldFat      Float
  newCalories Float
  newProtein  Float
  newCarbs    Float
  newFat      Float
  reason      String   // "trend_loss_too_slow" | "trend_loss_too_fast" | "user_manual" | ...
  mode        String   // "suggested" | "auto"
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

// Coaching contextual (HU-09)
model Insight {
  id            Int       @id @default(autoincrement())
  userId        Int
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String    // "trend_calories" | "adherence" | "streak" | "macro_imbalance" | "milestone"
  title         String
  body          String
  dataJson      String    // JSON serializado con datos para gráfica
  createdAt     DateTime  @default(now())
  dismissedAt   DateTime?
  dismissReason String?   // "not_useful" | "seen" | "not_relevant"
  pushedAt      DateTime? // cuando se envió push (null si solo in-app)

  @@index([userId, createdAt])
  @@index([userId, dismissedAt])
}

// Web Push subscriptions (HU-09)
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Food {
  id           Int       @id @default(autoincrement())
  nombre       String
  categoria    String
  cal          Float
  p            Float
  c            Float
  f            Float
  gramsPerUnit Float?
  unitLabel    String?
  source       String    @default("usda")
  userId       Int?
  usageCount   Int       @default(0)
  lastUsedAt   DateTime?

  // Soporte regional (HU-12): null = global, "CO" = colombiano, "LAC" = LATAM genérico
  regionCode   String?

  // BD dos capas + votos (HU-04)
  verifiedAt   DateTime? // null = comunitario, fecha = verificado por admin
  verifiedBy   String?   // email del admin que verificó
  needsReview  Boolean   @default(false)
  voteScore    Int       @default(0) // denormalizado: sum(vote) sobre FoodVote
  voteCount    Int       @default(0) // denormalizado: count(*) sobre FoodVote

  // Barcode (HU-03): EAN-13 / EAN-8 / UPC normalizado
  barcode      String?   @unique

  votes        FoodVote[]

  @@index([nombre])
  @@index([userId])
  @@index([lastUsedAt])
  @@index([regionCode])
  @@index([needsReview])
}

model FoodVote {
  id        Int      @id @default(autoincrement())
  userId    Int
  foodId    Int
  vote      Int      // +1 o -1
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  food      Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@unique([userId, foodId])
  @@index([foodId])
}
