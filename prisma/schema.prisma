generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  passwordHash  String
  createdAt     DateTime @default(now())

  // Perfil
  name          String?
  avatarEmoji   String?
  age           Int?
  sex           String?  // "male" | "female"
  weightKg      Float?
  heightCm      Float?
  activityLevel String?  // "sedentary" | "light" | "moderate" | "active" | "very_active"
  fitnessGoal   String?  // "lose" | "maintain" | "gain"

  // Soporte regional (HU-12): ISO 3166-1 alpha-2 ("CO", "MX", "AR", etc.)
  countryCode   String?

  // Modo de tracking (HU-11): "macros" (default) | "habits"
  trackingMode  String   @default("macros")

  meals             Meal[]
  goals             Goal[]
  foodVotes         FoodVote[]
  weights           WeightEntry[]
  goalLogs          GoalAdjustmentLog[]
  insights          Insight[]
  pushSubscriptions PushSubscription[]
  habits            HabitEntry[]
  wearables         WearableConnection[]
  activities        ActivityData[]
  recipes           Recipe[]
  mealPlans         MealPlan[]
}

model Meal {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime
  dateLocal  String?
  category   String
  name       String
  imageUrl   String?
  weightG    Float
  calories   Float
  protein    Float
  carbs      Float
  fat        Float
  confidence Float
  items      String?
  createdAt  DateTime @default(now())

  // Snapshot de micros al momento de registrar (HU-07)
  fiber      Float?
  sugar      Float?
  sodium     Float?
  potassium  Float?
  calcium    Float?
  iron       Float?
  vitaminC   Float?
  vitaminD   Float?
  vitaminB12 Float?
  vitaminA   Float?
  folate     Float?
  magnesium  Float?
  zinc       Float?
  omega3     Float?
  omega6     Float?

  @@index([userId, dateLocal])
}

model Goal {
  id       Int   @id @default(autoincrement())
  userId   Int
  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  calories Float
  protein  Float
  carbs    Float
  fat      Float

  // Targets adaptativos (HU-05): "manual" | "suggested" | "auto"
  adjustmentMode String @default("manual")

  adjustments GoalAdjustmentLog[]

  // Un Goal por usuario (D6): permite upsert atómico y evita duplicados.
  @@unique([userId])
}

model WeightEntry {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // YYYY-MM-DD
  weightKg  Float
  source    String   @default("manual") // "manual" | "wearable"
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

model GoalAdjustmentLog {
  id          Int      @id @default(autoincrement())
  userId      Int
  goalId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal        Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  // Snapshot del goal anterior y nuevo
  oldCalories Float
  oldProtein  Float
  oldCarbs    Float
  oldFat      Float
  newCalories Float
  newProtein  Float
  newCarbs    Float
  newFat      Float
  reason      String   // "trend_loss_too_slow" | "trend_loss_too_fast" | "user_manual" | ...
  mode        String   // "suggested" | "auto"
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

// Coaching contextual (HU-09)
model Insight {
  id            Int       @id @default(autoincrement())
  userId        Int
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String    // "trend_calories" | "adherence" | "streak" | "macro_imbalance" | "milestone"
  title         String
  body          String
  dataJson      String    // JSON serializado con datos para gráfica
  createdAt     DateTime  @default(now())
  dismissedAt   DateTime?
  dismissReason String?   // "not_useful" | "seen" | "not_relevant"
  pushedAt      DateTime? // cuando se envió push (null si solo in-app)

  @@index([userId, createdAt])
  @@index([userId, dismissedAt])
}

// Web Push subscriptions (HU-09)
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// Wearables OAuth (HU-08): conexiones a Fitbit / Oura / Garmin
model WearableConnection {
  id             Int       @id @default(autoincrement())
  userId         Int
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String    // "fitbit" | "oura" | "garmin"
  providerUserId String    // ID del usuario en el sistema externo
  accessToken    String    // ENCRIPTADO (AES-256-GCM via lib/crypto)
  refreshToken   String    // idem
  expiresAt      DateTime
  scopes         String    // CSV de scopes concedidos
  connectedAt    DateTime  @default(now())
  lastSyncedAt   DateTime?

  @@unique([userId, provider])
  @@index([provider, expiresAt])
}

model ActivityData {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            String   // YYYY-MM-DD
  provider        String   // "fitbit" | "oura" | "garmin"
  steps           Int?
  caloriesBurned  Int?
  activeMinutes   Int?
  distanceKm      Float?
  sleepMinutes    Int?
  sleepEfficiency Float?   // 0-1
  hrv             Float?   // ms
  restingHR       Int?     // bpm
  rawJson         String?  // raw del wearable, para debug y migrar campos futuros
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, date, provider])
  @@index([userId, date])
}

// Meal Planning (HU-06): recetas + planes semanales
model Recipe {
  id           Int       @id @default(autoincrement())
  name         String
  description  String?
  instructions String
  prepTimeMin  Int
  cookTimeMin  Int
  servings     Int       @default(1)
  // Tags como CSV (sqlite no soporta arrays nativos)
  dietTags     String    @default("") // CSV: "vegano,vegetariano,keto,paleo,sin-gluten"
  allergyTags  String    @default("") // CSV: "lacteos,gluten,frutos-secos,mariscos,huevo,soja"
  costLevel    Int       @default(2)  // 1 bajo, 2 medio, 3 alto
  cuisineCode  String?   // "CO", "MX", "ITA", etc.
  source       String    @default("seed") // "seed" | "user" | "imported"
  userId       Int?      // null = pública (seed/imported)
  imageUrl     String?
  // Macros estimadas por serving (denormalizado para listing rápido)
  caloriesPerServing Int?
  proteinPerServing  Float?
  carbsPerServing    Float?
  fatPerServing      Float?
  createdAt    DateTime  @default(now())

  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredients  RecipeIngredient[]
  plannedMeals PlannedMeal[]

  @@index([cuisineCode])
  @@index([userId])
}

model RecipeIngredient {
  id              Int     @id @default(autoincrement())
  recipeId        Int
  foodId          Int
  gramsPerServing Float
  optional        Boolean @default(false)

  recipe          Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  food            Food    @relation(fields: [foodId], references: [id])

  @@index([recipeId])
  @@index([foodId])
}

model MealPlan {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate   String    // YYYY-MM-DD (lunes de la semana)
  endDate     String    // YYYY-MM-DD (domingo)
  preferences String    // JSON: { diet, allergies, mealsPerDay, maxPrepMinutes, costLevel }
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  plannedMeals PlannedMeal[]

  @@index([userId, startDate])
  @@index([userId, isActive])
}

model PlannedMeal {
  id         Int      @id @default(autoincrement())
  planId     Int
  date       String   // YYYY-MM-DD
  mealType   String   // "breakfast" | "lunch" | "dinner" | "snack"
  recipeId   Int
  servings   Float    @default(1)
  consumed   Boolean  @default(false)
  consumedAt DateTime?

  plan       MealPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  recipe     Recipe   @relation(fields: [recipeId], references: [id])

  @@unique([planId, date, mealType])
  @@index([planId, date])
  @@index([recipeId])
}

// Modo hábitos (HU-11): porciones visuales por día en lugar de macros exactos
model HabitEntry {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            String   // YYYY-MM-DD
  proteinPortions Int      @default(0)
  vegPortions     Int      @default(0)
  carbPortions   Int      @default(0)
  fatPortions     Int      @default(0)
  fruitPortions   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Food {
  id           Int       @id @default(autoincrement())
  nombre       String
  categoria    String
  cal          Float
  p            Float
  c            Float
  f            Float
  gramsPerUnit Float?
  unitLabel    String?
  source       String    @default("usda")
  userId       Int?
  usageCount   Int       @default(0)
  lastUsedAt   DateTime?

  recipeIngredients RecipeIngredient[]

  // Soporte regional (HU-12): null = global, "CO" = colombiano, "LAC" = LATAM genérico
  regionCode   String?

  // BD dos capas + votos (HU-04)
  verifiedAt   DateTime? // null = comunitario, fecha = verificado por admin
  verifiedBy   String?   // email del admin que verificó
  needsReview  Boolean   @default(false)
  voteScore    Int       @default(0) // denormalizado: sum(vote) sobre FoodVote
  voteCount    Int       @default(0) // denormalizado: count(*) sobre FoodVote

  // Barcode (HU-03): EAN-13 / EAN-8 / UPC normalizado
  barcode      String?   @unique

  // Micronutrientes (HU-07) — por 100g, todos opcionales (no todas las
  // fuentes los proveen). Unidades: g (fiber, sugar, omega3/6), mg
  // (sodium, potassium, calcium, iron, vitC, magnesium, zinc), µg
  // (vitD, vitB12, folate), µg RAE (vitA).
  fiber        Float?
  sugar        Float?
  sodium       Float?
  potassium    Float?
  calcium      Float?
  iron         Float?
  vitaminC     Float?
  vitaminD     Float?
  vitaminB12   Float?
  vitaminA     Float?
  folate       Float?
  magnesium    Float?
  zinc         Float?
  omega3       Float?
  omega6       Float?

  // FDC ID en USDA FoodData Central — para deduplicar imports
  fdcId        Int?      @unique

  votes        FoodVote[]

  @@index([nombre])
  @@index([userId])
  @@index([lastUsedAt])
  @@index([regionCode])
  @@index([needsReview])
}

model FoodVote {
  id        Int      @id @default(autoincrement())
  userId    Int
  foodId    Int
  vote      Int      // +1 o -1
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  food      Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@unique([userId, foodId])
  @@index([foodId])
}
